{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "rcmkodiak"
		},
		"LS_rcmsnowflake_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_rcmsnowflake'"
		},
		"LS_Blob_Landing_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'LS_Blob_Landing'"
		},
		"LS_Blob_Raw_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'LS_Blob_Raw'"
		},
		"LS_rcmsnowflake_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "RCM"
		},
		"LS_rcmsnowflake_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "rcmkodiak_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_rcmsnowflake_password": {
						"value": "[parameters('LS_rcmsnowflake_password')]"
					},
					"LS_Blob_Landing_sasUri": {
						"value": "[parameters('LS_Blob_Landing_sasUri')]"
					},
					"LS_Blob_Raw_sasUri": {
						"value": "[parameters('LS_Blob_Raw_sasUri')]"
					},
					"LS_rcmsnowflake_properties_typeProperties_database": {
						"value": "[parameters('LS_rcmsnowflake_properties_typeProperties_database')]"
					},
					"LS_rcmsnowflake_properties_typeProperties_role": {
						"value": "[parameters('LS_rcmsnowflake_properties_typeProperties_role')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}